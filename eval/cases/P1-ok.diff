+/// Reading time of each release, in minutes, computed once from its notes.
+final Map<String, int> readingMinutesById = <String, int>{
+  for (final Release release in releases)
+    release.id: (RegExp(r'\S+').allMatches(release.notes).length / 200).ceil(),
+};
