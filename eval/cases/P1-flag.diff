@@ -29,7 +29,10 @@ class ReleasesPage extends StatelessWidget {
                 child: const Icon(Icons.new_releases),
               ),
               title: Text('Version ${release.version}'),
-              subtitle: Text('${release.date} · ${release.summary}'),
+              subtitle: Text(
+                '${release.date} · ${release.summary} · '
+                '${_readingMinutes(release.notes)} min read',
+              ),
               trailing: const Icon(Icons.chevron_right),
               onTap: () => context.go('/releases/${release.id}'),
             ),
@@ -38,3 +41,8 @@ class ReleasesPage extends StatelessWidget {
     );
   }
 }
+
+int _readingMinutes(String notes) {
+  final int words = RegExp(r'\S+').allMatches(notes).length;
+  return (words / 200).ceil();
+}
