+/// The releases whose version starts with 0, or null when there is none.
+List<Release>? betaReleases() {
+  final List<Release> found = <Release>[
+    for (final Release release in releases)
+      if (release.version.startsWith('0.')) release,
+  ];
+  return found.isEmpty ? null : found;
+}
